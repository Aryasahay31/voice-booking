# ---------- business ----------
BUSINESS_TZ=Asia/Kolkata
BUSINESS_NAME=Glow Studio
DEFAULT_COUNTRY_CODE=91

# ---------- confirmations ----------
# none | whatsapp | sms   (none = just print the message in the terminal)
NOTIFY_CHANNEL=none
# Optional: salon owner's number for callback alerts (needs Twilio)
STAFF_PHONE=

# From console.twilio.com (only needed when NOTIFY_CHANNEL is whatsapp or sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- database ----------
# Postgres connection string from Neon. Leave EMPTY on your laptop to use the local SQLite file.
DATABASE_URL=

# ---------- security ----------
# Long random secret. Required in the cloud; the agent and MCP server must send the same one.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=

# ---------- MCP server ----------
BOOKING_API_URL=http://127.0.0.1:8000
MCP_PORT=8001

# ---------- website calls (Phase 2) ----------
# Same values as the LIVEKIT_ lines in agent/.env
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Max call tokens per visitor IP per 10 minutes
TOKEN_RATE_LIMIT=5